NYASM_IMAGE=nyaservermonitor
NYASM_VERSION=dev
NYASM_PUBLIC_URL=https://monitor.example.com
NYASM_HOST_PORT=8080
NYASM_BIND_ADDR=127.0.0.1

# Keep this stable. It encrypts node tokens so the install command can be
# regenerated without rotating a node credential.
NYASM_NODE_TOKEN_KEY=replace-with-a-random-secret-at-least-16-characters

# Optional for alert notification targets and secrets.
NYASM_NOTIFICATION_KEY=replace-with-a-different-random-secret

# Optional for local unsigned development images. Production release images
# should be built by CI with the Ed25519 update public key and signing secret.
NYASM_UPDATE_PUBLIC_KEY=
